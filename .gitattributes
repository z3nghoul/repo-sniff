# Normalize line endings to LF in the working tree on every OS, so rustfmt
# and snapshot tests behave the same on Windows as on Linux.
* text=auto eol=lf

# Fixtures must reach the tests byte for byte: some rules depend on CRLF
# line endings or on invisible characters, so git must never convert them.
crates/repo-sniff-core/tests/fixtures/** -text
crates/repo-sniff/tests/fixtures/** -text
